# Copy to .env and fill in. Set these same vars in Vercel → Project → Settings → Environment Variables.

# Neon Postgres pooled connection string (used at runtime by the app)
DATABASE_URL=

# Neon Postgres direct/unpooled connection string (used for migrations)
DATABASE_URL_UNPOOLED=

# Anthropic API key — powers the AI "Analyze" feature
ANTHROPIC_API_KEY=
